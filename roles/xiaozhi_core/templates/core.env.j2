{% macro env_quote(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro %}
# Managed by Ansible; root:root 0600. Never print or diff.
XIAOZHI_CORE_ID={{ env_quote(inventory_hostname) }}
XIAOZHI_CORE_HOST={{ env_quote(cluster_ip) }}
XIAOZHI_CORE_PORT={{ env_quote(xiaozhi_core_port) }}
XIAOZHI_CORE_AUTH_KEY={{ env_quote(vault_mqtt_server_secret) }}
XIAOZHI_CORE_GATEWAY_IPS={{ env_quote(groups['xiaozhi_mqtt_gateways'] | sort | map('extract', hostvars, 'cluster_ip') | join(',')) }}
XIAOZHI_CORE_MANAGEMENT_INTERFACE={{ env_quote(xiaozhi_core_management_interfaces[0]) }}
XIAOZHI_CORE_INGRESS_STATE_FILE="/etc/xiaozhi-ingress.json"

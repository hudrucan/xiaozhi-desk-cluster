# Managed by Ansible.
[Unit]
Description=Xiaozhi cluster transport core (providers disabled)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ xiaozhi_core_service_user }}
Group={{ xiaozhi_core_service_user }}
WorkingDirectory={{ xiaozhi_core_release }}/repo/main/xiaozhi-server
EnvironmentFile=/etc/xiaozhi-core.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ xiaozhi_core_release }}/venv/bin/python core_server.py
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=15s
StandardInput=null
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

[Install]
WantedBy=multi-user.target

[Unit]
Description=Desk WireGuard HA prepared tunnel and scoped LAN routing
Wants=network-online.target
After=network-online.target
Before=desk-vpn-vip.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/wg-quick up /etc/desk-vpn/wgdesk0.conf
ExecStop=/usr/bin/wg-quick down /etc/desk-vpn/wgdesk0.conf
ExecReload=/usr/bin/python3 /usr/local/libexec/desk-vpn/reload.py
ExecStopPost=/usr/bin/python3 /usr/local/libexec/desk-vpn/firewall.py down
TimeoutStartSec=30
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target

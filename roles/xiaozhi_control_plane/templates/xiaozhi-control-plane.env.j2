{% macro env_quote(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro %}
# Managed by Ansible; root:root 0600. Do not print or diff this file.
XIAOZHI_NATS_SERVERS={{ env_quote(xiaozhi_control_plane_nats_servers) }}
XIAOZHI_NATS_USER={{ env_quote(nats_client_user) }}
XIAOZHI_NATS_PASSWORD={{ env_quote(nats_client_password) }}
XIAOZHI_CONTROL_PLANE_HOST={{ env_quote(cluster_ip) }}
XIAOZHI_CONTROL_PLANE_PORT={{ env_quote(xiaozhi_control_plane_port) }}
XIAOZHI_CONTROL_PLANE_ALLOW_REMOTE="true"
XIAOZHI_CONFIG_RECONCILE_SECONDS={{ env_quote(xiaozhi_control_plane_reconcile_seconds) }}
{% if xiaozhi_control_plane_secret_provisioning %}
XIAOZHI_SECRET_PROVISION_KEY={{ env_quote(vault_xiaozhi_secret_provision_key) }}
XIAOZHI_SECRET_PROVISION_NODES={{ env_quote(xiaozhi_control_plane_secret_nodes | to_json) }}
{% endif %}
XIAOZHI_MQTT_BOOTSTRAP_ENABLED={{ env_quote('true' if xiaozhi_control_plane_mqtt_bootstrap else 'false') }}
{% if xiaozhi_control_plane_mqtt_bootstrap %}
XIAOZHI_BOOTSTRAP_MQTT_SIGNATURE_KEY={{ env_quote(vault_mqtt_signature_key) }}
XIAOZHI_BOOTSTRAP_MQTT_PORT={{ env_quote(xiaozhi_bootstrap_mqtt_port) }}
XIAOZHI_BOOTSTRAP_INGRESS_STATE_FILE="/etc/xiaozhi-ingress.json"
XIAOZHI_BOOTSTRAP_ALLOWED_DEVICES={{ env_quote(xiaozhi_bootstrap_allowed_devices | to_json) }}
{% endif %}

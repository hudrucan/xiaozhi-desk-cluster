[Unit]
Description=Desk VPN wg-easy native UI (unprivileged)
After=network-online.target
Wants=network-online.target
[Service]
User=desk-vpn-ui
Group=desk-vpn-ui
WorkingDirectory=/opt/desk-vpn-ui/app
EnvironmentFile=/etc/desk-vpn-ui/native.env
ExecStart=/opt/desk-vpn-ui/node-v24.19.0-linux-arm64/bin/node /opt/desk-vpn-ui/app/server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0007
Nice=10
CPUWeight=1
CPUQuota=35%
MemoryMax=256M
TasksMax=32
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/desk-vpn-ui
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/etc/desk-vpn -/etc/desk-vpn-recovery -/etc/desk-vpn-ddns -/etc/desk-monitoring -/etc/desk-dns -/etc/nats -/etc/xiaozhi-control-plane /var/lib/desk-vpn-ui-sync -/etc/desk-vpn-ui/config.json -/etc/desk-vpn-ui/seed.json -/etc/desk-vpn-ui/tls.key
[Install]
WantedBy=multi-user.target

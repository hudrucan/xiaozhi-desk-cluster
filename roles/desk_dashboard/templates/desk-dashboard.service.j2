[Unit]
Description=Read-only Desk Cluster dashboard metadata
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/libexec/desk-dashboard --config /etc/desk-dashboard/config.json
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=24MiB
Restart=on-failure
RestartSec=5
CPUWeight=1
CPUQuota=3%
Nice=10
MemoryMax=48M
TasksMax=32
LimitNOFILE=128
UMask=0077
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/desk-vpn-ui -/var/lib/desk-vpn-ui -/var/lib/desk-vpn-ui-sync -/etc/desk-vpn-recovery -/etc/desk-vpn-ddns -/run/credentials -/etc/desk-vpn/wgdesk0.conf -/etc/desk-vpn/keepalived.conf /var/lib /opt -/etc/desk-node-control -/etc/nats -/etc/haproxy -/etc/xiaozhi-mqtt-gateway.env -/etc/xiaozhi-core.env -/etc/xiaozhi-worker.env -/etc/xiaozhi-control-plane.env -/etc/xiaozhi-control-plane -/etc/xiaozhi-worker-asr -/etc/xiaozhi-worker-llm -/etc/xiaozhi-worker-tts -/etc/xiaozhi-core-tts -/etc/xiaozhi-runtime-apply -/etc/desk-monitoring -/etc/desk-dns/sync -/etc/desk-dns/backend -/etc/desk-dns/sync-agent.json -/etc/desk-dns/cluster-ui.json
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

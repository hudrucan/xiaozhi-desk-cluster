# Managed by Ansible; VIP is a deployment snapshot of Cloud desired state.
global
    log /dev/log local0
    user haproxy
    group haproxy
    stats socket {{ xiaozhi_ingress_stats_socket }} mode 600 level user

defaults
    mode http
    log global
    option httplog
    timeout connect 3s
    timeout client 60s
    timeout server 60s
    timeout check 3s

frontend xiaozhi_settings
    bind {{ xiaozhi_ingress_vip }}:{{ xiaozhi_ingress_port }}
    # Private encrypted peer operations never traverse the management frontend.
    http-request deny deny_status 404 if { path_beg /internal/ }
{% if xiaozhi_ingress_unified_ui_enabled | default(false) %}
# BEGIN DESK DNS UI ROUTE
    http-request deny unless { src 192.168.1.0/24 127.0.0.1 } or !{ path_beg /dns /monitor{% if desk_network_enabled | default(false) %} /network{% endif %}{% if desk_dashboard_enabled | default(false) %} /api/cluster/status /api/cluster/operations{% endif %} } !{ path / }
{% if not (desk_dashboard_enabled | default(false)) %}
    http-request return status 200 content-type text/html file /etc/desk-ui/index.html if { path / }
{% endif %}
    http-request redirect location /xiaozhi/ code 302 if { path /xiaozhi /settings /settings/ }
    # Bootstrap /xiaozhi/ota/ keeps its existing public transport path.
    http-request replace-path ^/xiaozhi/(.*)$ /settings/\1 if { path_beg /xiaozhi/ } !{ path_beg /xiaozhi/ota }
    http-request redirect location /dns/ code 302 if { path /dns }
{% if xiaozhi_ingress_monitoring_enabled | default(false) %}
    http-request redirect location /monitor/ code 302 if { path /monitor }
{% endif %}
{% if desk_dashboard_enabled | default(false) %}
{% if desk_node_control_enabled | default(false) %}
    use_backend desk_node_control if { path /api/cluster/operations /api/cluster/operations/prepare /api/cluster/operations/reboot /api/cluster/operations/resume }
{% endif %}
    use_backend desk_dashboard if { path / /api/cluster/status }
{% endif %}
    use_backend desk_adguard_ui if { path_beg /dns/ }
# END DESK DNS UI ROUTE
{% endif %}
{% if xiaozhi_ingress_monitoring_enabled | default(false) %}
# BEGIN DESK MONITORING ROUTE
{% if not (xiaozhi_ingress_unified_ui_enabled | default(false)) %}
    http-request redirect location /monitor/ code 302 if { path /monitor }
{% endif %}
    use_backend desk_monitoring_hubs if { path_beg /monitor/ }
# END DESK MONITORING ROUTE
{% endif %}
{% if desk_network_enabled | default(false) %}
# BEGIN DESK NETWORK ROUTE
    http-request redirect location /network/ code 302 if { path /network }
    use_backend desk_network if { path_beg /network/ }
# END DESK NETWORK ROUTE
{% endif %}
    default_backend xiaozhi_control_planes

backend xiaozhi_control_planes
    balance roundrobin
    option httpchk
    http-check send meth GET uri /healthz ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
{% for node in groups['xiaozhi_ingress'] | sort %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:{{ xiaozhi_ingress_backend_port }} check inter 2s fall 2 rise 2
{% endfor %}
{% if xiaozhi_ingress_monitoring_enabled | default(false) %}
# BEGIN DESK MONITORING BACKEND
backend desk_monitoring_hubs
    balance roundrobin
    cookie desk_monitor_hub insert indirect nocache httponly attr "SameSite=Lax"
    timeout server 360s
    http-response set-header X-Desk-Monitor-Hub %[srv_name]
    option httpchk
    http-check send meth GET uri /api/health ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
    http-request replace-path ^/monitor/(.*)$ /\1
{% for node in groups.get('desk_monitoring', []) | sort %}
{% if desk_monitoring_load_aware_enabled | default(false) %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:{{ desk_monitoring_proxy_port | default(8091) if desk_monitoring_sync_enabled | default(false) else 8090 }} cookie {{ node }} check inter 5s fall 2 rise 2 weight 100 agent-check agent-addr {{ cluster_ip }} agent-port 8012 agent-inter 30s agent-send "{{ node }}\n"
{% else %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:{{ desk_monitoring_proxy_port | default(8091) if desk_monitoring_sync_enabled | default(false) else 8090 }} cookie {{ node }} check inter 5s fall 2 rise 2
{% endif %}
{% endfor %}
# END DESK MONITORING BACKEND
{% endif %}
{% if xiaozhi_ingress_unified_ui_enabled | default(false) %}
# BEGIN DESK DNS UI BACKEND
backend desk_adguard_ui
    timeout server 180s
    option httpchk
    http-check send meth GET uri /control/desk_health ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
    http-request replace-path ^/dns/(.*)$ /\1
    http-response replace-header Location ^/(.*)$ /dns/\1
    http-response replace-header Set-Cookie (.*[Pp]ath=)/([^;]*)(.*) \1/dns/\2\3
    server dns_vip {{ desk_dns_vip }}:3001 check inter 5s fall 2 rise 2
# END DESK DNS UI BACKEND
{% endif %}
{% if xiaozhi_ingress_unified_ui_enabled | default(false) and desk_dashboard_enabled | default(false) %}
# BEGIN DESK DASHBOARD BACKEND
backend desk_dashboard
    balance roundrobin
    timeout server 5s
    option httpchk
    http-check send meth GET uri /health ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
{% for node in groups['deskboxes'] | sort %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:{{ desk_dashboard_port | default(8010) }} check inter 5s fall 2 rise 2
{% endfor %}
{% if desk_node_control_enabled | default(false) %}
backend desk_node_control
    balance roundrobin
    timeout server 25s
    option httpchk
    http-check send meth GET uri /health ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
{% for node in groups['deskboxes'] | sort %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:{{ desk_node_control_port | default(8011) }} check inter 5s fall 2 rise 2
{% endfor %}
{% endif %}
# END DESK DASHBOARD BACKEND
{% endif %}

{% if desk_network_enabled | default(false) %}
# BEGIN DESK NETWORK BACKEND
backend desk_network
    mode http
    balance first
    retries 2
    option redispatch
    retry-on conn-failure empty-response response-timeout 503 504
    http-request disable-l7-retry unless { method GET HEAD }
    option httpchk GET /health
    http-check expect status 200
    timeout server 60s
{% for node in groups['deskboxes'] | sort %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:20213 check inter 3s fall 2 rise 1
{% endfor %}
# END DESK NETWORK BACKEND
{% endif %}

{% if desk_homeassistant_enabled | default(false) %}
# BEGIN DESK HOME ASSISTANT
{{ lookup('template', desk_repo_root + '/roles/desk_homeassistant/templates/proxy.cfg.j2') }}
# END DESK HOME ASSISTANT
{% endif %}

+package alerts
+
+import (
+	"net"
+	"net/url"
+	"os"
+)
+
+// Reuse management VIP ownership; metrics and manual notification tests stay local.
+func notificationOwner(webhook string) bool {
+	vip := os.Getenv("DESK_NOTIFICATION_VIP")
+	if vip == "" {
+		return true
+	}
+	destination, err := url.Parse(webhook)
+	if err != nil {
+		return false
+	}
+	if destination.Scheme != "ntfy" || destination.Hostname() != vip {
+		return true
+	}
+	addresses, err := net.InterfaceAddrs()
+	return err == nil && ownsNotificationVIP(vip, addresses)
+}
+
+func ownsNotificationVIP(vip string, addresses []net.Addr) bool {
+	wanted := net.ParseIP(vip)
+	if wanted == nil {
+		return false
+	}
+	for _, address := range addresses {
+		ip, _, err := net.ParseCIDR(address.String())
+		if err == nil && ip.Equal(wanted) {
+			return true
+		}
+	}
+	return false
+}

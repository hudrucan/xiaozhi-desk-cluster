--- /dev/null
+++ b/internal/site/src/lib/agent-install.ts
@@ -0,0 +1,28 @@
+const quote = (value: string) => `'${value.replaceAll("'", "'\\''")}'`
+
+/** Linux/systemd setup: keep installer credentials, then trust every cluster hub. */
+export function clusterLinuxCommand(port: string, publicKey: string, token: string, hubURL: string, keys: string[], chinaMirrors = false) {
+	if (keys.length !== 3 || new Set(keys).size !== 3 || !keys.includes(publicKey) || keys.some(key => !/^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$/.test(key))) {
+		throw new Error("Three valid cluster public keys are required. Refresh the page and try again.")
+	}
+	return `(
+set -eu
+command -v systemctl >/dev/null || { printf '%s\\n' 'This command requires Linux with systemd.' >&2; exit 1; }
+if [ "$(id -u)" -eq 0 ]; then
+  beszel_root() { "$@"; }
+else
+  beszel_root() { sudo "$@"; }
+fi
+curl -fsSL https://get.beszel.dev -o /tmp/install-agent.sh
+beszel_root bash /tmp/install-agent.sh -p ${quote(port)} -k ${quote(publicKey)} -t ${quote(token)} -url ${quote(hubURL)}${chinaMirrors ? " --china-mirrors" : ""}
+beszel_root install -d -m 0755 /etc/beszel-agent /etc/systemd/system/beszel-agent.service.d
+printf '%s\\n' ${keys.map(quote).join(" ")} | beszel_root tee /etc/beszel-agent/hub-keys.pub >/dev/null
+beszel_root chmod 0644 /etc/beszel-agent/hub-keys.pub
+printf '%s\\n' '[Service]' 'Environment="KEY="' 'Environment="BESZEL_AGENT_KEY="' 'Environment="KEY_FILE=/etc/beszel-agent/hub-keys.pub"' 'Environment="BESZEL_AGENT_KEY_FILE=/etc/beszel-agent/hub-keys.pub"' | beszel_root tee /etc/systemd/system/beszel-agent.service.d/cluster-keys.conf >/dev/null
+beszel_root chmod 0644 /etc/systemd/system/beszel-agent.service.d/cluster-keys.conf
+beszel_root systemctl daemon-reload
+beszel_root systemctl restart beszel-agent
+beszel_root systemctl is-active --quiet beszel-agent
+printf '%s\\n' 'Beszel agent configured to trust all 3 cluster hubs.'
+)`
+}

+// deskUpdateInterval only backs off offline, on-demand SSH fallback. The cluster
+// uses SSH-only agents, so keep its normal recovery detection on either address.
+func (sys *System) deskUpdateInterval() time.Duration {
+	if sys.GetStatus() == down && sys.WsConn == nil {
+		switch sys.Host {
+		case "10.10.10.11", "10.10.10.12", "10.10.10.13",
+			"192.168.1.101", "192.168.1.102", "192.168.1.103":
+		default:
+			return time.Hour
+		}
+	}
+	return time.Duration(interval) * time.Millisecond
+}

@@ -0,0 +1,38 @@
+package systems
+
+import (
+	"testing"
+	"time"
+
+	"github.com/henrygd/beszel/internal/hub/ws"
+)
+
+func TestDeskSSHBackoff(t *testing.T) {
+	sys := &System{Host: "192.168.1.28", Status: down}
+	if got := sys.deskUpdateInterval(); got != time.Hour {
+		t.Fatalf("offline fallback: %s", got)
+	}
+	// A replacement system with a new WS connection must never inherit SSH delay.
+	sys.WsConn = &ws.WsConn{}
+	if got := sys.deskUpdateInterval(); got != time.Minute {
+		t.Fatalf("WS reconnect delayed: %s", got)
+	}
+	sys.WsConn = nil
+	for _, status := range []string{up, pending, paused} {
+		sys.swapStatus(status)
+		if got := sys.deskUpdateInterval(); got != time.Minute {
+			t.Fatalf("%s cadence: %s", status, got)
+		}
+	}
+	sys.swapStatus(down)
+	for _, host := range []string{"10.10.10.11", "10.10.10.12", "10.10.10.13", "192.168.1.101", "192.168.1.102", "192.168.1.103"} {
+		sys.Host = host
+		if got := sys.deskUpdateInterval(); got != time.Minute {
+			t.Fatalf("SSH-only cluster recovery delayed for %s: %s", host, got)
+		}
+	}
+	sys.Host = "192.168.1.115"
+	if got := sys.deskUpdateInterval(); got != time.Hour {
+		t.Fatalf("second offline device: %s", got)
+	}
+}

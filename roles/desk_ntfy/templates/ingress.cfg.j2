# BEGIN DESK NTFY
# Reuse the management VIP and existing HAProxy master; no separate election.
frontend desk_ntfy_vip
    bind {{ desk_ntfy_vip }}:2586
    no log
    http-request deny unless { src 192.168.1.0/24 10.77.0.0/24 127.0.0.1 }
    default_backend desk_ntfy_replicas

backend desk_ntfy_replicas
    option httpchk GET /ready
    http-check expect status 200
    retries 2
    option redispatch
    # Publishing and auth mutations must never be replayed after an ambiguous response.
    http-request disable-l7-retry unless { method GET HEAD }
    timeout server 90s
    timeout tunnel 1h
{% for node in groups['deskboxes'] | sort %}
    server {{ node }} {{ hostvars[node].cluster_ip }}:2588 check inter 2s fall 1 rise 2 on-marked-down shutdown-sessions{% if node != inventory_hostname %} backup{% endif %}

{% endfor %}

# This per-node boundary is reachable only from cluster ingress peers.
frontend desk_ntfy_node
    bind {{ cluster_ip }}:2588
    no log
    http-request deny unless { src 127.0.0.1 {% for node in groups['deskboxes'] | sort %}{{ hostvars[node].cluster_ip }} {% endfor %}}
    acl ambiguous_path path_reg [%]|//|/\.\.?(\/|$)
    http-request deny deny_status 400 if ambiguous_path
    http-request deny if { path /v1/account } { method POST }
    http-request deny if { path_beg /v1/account/access } !{ method GET }
    # Strip untrusted forwarding identity before native rate-limit handling.
    http-request set-header X-Forwarded-For %[src]
    http-request deny if { path_beg /v1/webpush /_matrix /file/ /metrics }
    use_backend desk_ntfy_adapter if { path /ready }
    use_backend desk_ntfy_adapter if { path_beg /v1/ } !{ method GET HEAD }
    # The official SPA uses GET pages; streaming, auth and API reads stay native.
    use_backend desk_ntfy_adapter if { method GET HEAD } !{ path_beg /v1/ } !{ path_end /json /sse /ws /auth }
    default_backend desk_ntfy_native

backend desk_ntfy_adapter
    server local 127.0.0.1:2590

backend desk_ntfy_native
    option httpchk GET /ready
    http-check expect status 200
    timeout server 90s
    timeout tunnel 1h
    server local 127.0.0.1:2587 check port 2590 inter 2s fall 1 rise 1 on-marked-down shutdown-sessions
# END DESK NTFY

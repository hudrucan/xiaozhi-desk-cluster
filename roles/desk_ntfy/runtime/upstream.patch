diff --git a/src/handlers/subscribe.rs b/src/handlers/subscribe.rs
index 92ad033..04eb44b 100644
--- a/src/handlers/subscribe.rs
+++ b/src/handlers/subscribe.rs
@@ -68,2 +68,3 @@ pub struct SubscribeParams {
     pub poll: Option<String>,
+    pub id: Option<String>,
     pub since: Option<String>,
@@ -248,7 +249,12 @@ pub fn resolve_since(
     let conn = state.db.get()?;
-    match params.since() {
-        Since::None      => Ok(vec![]),
-        Since::Time(ts)  => Ok(cache::since_time(&conn, topic, ts)?),
-        Since::Id(id)    => Ok(cache::since_id(&conn, topic, &id)?),
+    let mut messages = match params.since() {
+        Since::None      => vec![],
+        Since::Time(ts)  => cache::since_time(&conn, topic, ts)?,
+        Since::Id(id)    => cache::since_id(&conn, topic, &id)?,
+    };
+    // iOS poll requests must decode exactly one message, not the full history.
+    if let Some(id) = &params.id {
+        messages.retain(|message| message.id == *id);
     }
+    Ok(messages)
 }

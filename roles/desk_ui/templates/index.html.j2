async function pollOperation(){if(!nodeControlEnabled||document.hidden||operationState.loading)return;operationState.loading=true;clearTimeout(operationState.timer);try{const value=await nodeAction('');if(value.protocol!=='desk-node-operation-v1')throw Error();operationState.history=operationHistory(value.history);operationState.observedAt=Date.now();operationState.unavailable=false;const op=value.operation;if(op){if(!membership.some(n=>n.id===op.node)||!['accepted','offline','starting','rejoined','needs_attention','draining','releasing_vips','maintenance','rebooting','recovering'].includes(op.state))throw Error();if(!/^[a-f0-9]{32}$/.test(op.id)||!Number.isInteger(op.started)||!Number.isInteger(op.expires))throw Error();operationState.latest=op;operationState.busy=op.state!=='rejoined'&&op.expires*1000>Date.now();const labels={draining:'Maintenance · waiting for existing jobs and conversations',releasing_vips:'Maintenance · handing VIPs to healthy peers',maintenance:'Maintenance ready · admission paused, VIPs released',rebooting:'Drain complete · reboot requested',recovering:'Restoring admission and VIP eligibility',accepted:'Reboot requested · waiting for shutdown',offline:'Offline · waiting for boot',starting:'Boot detected · waiting for services and config sync',rejoined:'Recovered · services ready and node rejoined',needs_attention:'Recovery not confirmed · manual attention required; no reboot retry'};showOperation(`${op.node} — ${labels[op.state]}`,true);}else{if(value.idle_confirmed===true){operationState.busy=false;operationState.latest=null;showOperation('');}else if(operationState.latest?.state==='rejoined'){operationState.busy=false;}else if(operationState.busy){showOperation('Reboot tracking unavailable. Check node status before another action.');}else{showOperation('');}}render();}catch{operationState.unavailable=true;renderEvents();if(operationState.busy)showOperation('Reboot tracking unavailable. No automatic retry; waiting for cluster status.');}fina
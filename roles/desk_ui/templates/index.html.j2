{% if desk_dashboard_enabled | default(false) %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>Desk Cluster</title>
<style>

#desk-cluster.dc-app{--dc-bg:light-dark(#f9f6ef,#100d08);--dc-surface:light-dark(#fffdf7,#1c170f);--dc-hover:light-dark(#f2ebdd,#241e14);--dc-text:light-dark(#352a1b,#f3ead8);--dc-muted:light-dark(#756754,#b9aa91);--dc-faint:light-dark(#8b7d69,#8e8069);--dc-border:light-dark(#e0d5c3,#3d3221);--dc-gold:light-dark(#896019,#d5a85e);--dc-soft:light-dark(#f2e3c8,#332817);--dc-green:light-dark(#267046,#82bf91);--dc-red:light-dark(#b53b31,#ed9282);--dc-vpn:light-dark(#40668d,#91aecf);background:var(--dc-bg);color:var(--dc-text);font:14px/1.5 Inter,ui-sans-serif,system-ui,sans-serif;min-height:740px;padding:0 30px 28px;box-sizing:border-box;border-radius:16px}
#desk-cluster *{box-sizing:border-box}
#desk-cluster .dc-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:23px 0;border-bottom:1px solid var(--dc-border);padding-right:74px}
#desk-cluster .dc-brand{display:flex;align-items:center;gap:10px;font-weight:650;letter-spacing:-.3px;font-size:17px}
#desk-cluster .dc-mark{color:var(--dc-gold);display:flex}
#desk-cluster .dc-address{font-size:12px;color:var(--dc-faint);font-family:ui-monospace,monospace}
#desk-cluster .dc-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;padding:32px 0 23px}
#desk-cluster .dc-eyebrow{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--dc-gold);font-weight:600}
#desk-cluster h1{font-size:29px;line-height:1.2;letter-spacing:-.9px;margin:8px 0 7px;font-weight:650}
#desk-cluster p{margin:0;color:var(--dc-muted)}
#desk-cluster .dc-online{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;color:var(--dc-green);font-size:12px}
#desk-cluster .dc-dot{display:inline-block;width:6px;height:6px;background:var(--dc-green);border-radius:50%;flex-shrink:0}
#desk-cluster .dc-summary{display:flex;flex-wrap:wrap;gap:10px 24px;padding:13px 0 22px;font-size:12px;color:var(--dc-muted)}
#desk-cluster .dc-summary span{display:flex;align-items:center;gap:7px}
#desk-cluster .dc-summary b{color:var(--dc-text);font-weight:500}
#desk-cluster .dc-nodes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
#desk-cluster .dc-node{border:1px solid var(--dc-border);border-radius:17px;overflow:hidden;background:var(--dc-surface);min-width:0}
#desk-cluster .dc-node[data-selected="true"]{border-color:var(--dc-muted)}
#desk-cluster .dc-node-head{padding:19px 19px 16px;display:flex;align-items:center;justify-content:space-between;gap:8px}
#desk-cluster .dc-node-name{font-weight:600;font-size:16px;letter-spacing:-.3px}
#desk-cluster .dc-ip{color:var(--dc-faint);font:12px/1.5 ui-monospace,monospace;margin-top:3px}
#desk-cluster .dc-roles{display:flex;flex-wrap:wrap;gap:6px;padding:0 19px;min-height:48px;align-content:flex-start}
#desk-cluster .dc-role{font-size:11px;border-radius:6px;padding:4px 7px;color:var(--dc-muted);background:var(--dc-hover);display:inline-flex;gap:5px;align-items:center}
#desk-cluster .dc-role.owner{color:var(--dc-gold);background:var(--dc-soft)}
#desk-cluster .dc-role.owner.dns{color:var(--dc-green)}
#desk-cluster .dc-role.owner.vpn{color:var(--dc-vpn)}
#desk-cluster .dc-role svg{width:12px;height:12px}
#desk-cluster .dc-activity{padding:15px 19px 19px;min-height:99px}
#desk-cluster .dc-label{font-size:10px;text-transform:uppercase;letter-spacing:1.25px;color:var(--dc-faint);font-weight:600}
#desk-cluster .dc-task{display:flex;gap:8px;align-items:center;margin-top:8px;font-weight:500;font-size:15px}
#desk-cluster .dc-task svg{color:var(--dc-gold);width:16px;height:16px;flex-shrink:0}
#desk-cluster .dc-task-meta{font-size:12px;color:var(--dc-muted);padding-top:4px}
#desk-cluster .dc-metrics{border-top:1px solid var(--dc-border);display:grid;grid-template-columns:1fr 1fr 1fr;padding:14px 19px;gap:10px}
#desk-cluster .dc-metric small{color:var(--dc-faint);font-size:11px;display:block;margin-bottom:3px}
#desk-cluster .dc-metric strong{font-size:13px;font-weight:500;font-variant-numeric:tabular-nums}
#desk-cluster .dc-bar{height:3px;background:var(--dc-hover);border-radius:3px;margin-top:7px;overflow:hidden}
#desk-cluster .dc-bar i{display:block;height:100%;background:var(--dc-gold);opacity:.8}
#desk-cluster .dc-node-button{width:100%;border:0;border-top:1px solid var(--dc-border);color:var(--dc-muted);background:transparent;display:flex;align-items:center;justify-content:space-between;padding:12px 19px;font:inherit;font-size:12px;min-height:44px}
#desk-cluster .dc-node-button:hover{background:var(--dc-hover);color:var(--dc-text)}
#desk-cluster .dc-node-button svg{width:14px;height:14px}
#desk-cluster .dc-detail{margin-top:16px;background:var(--dc-surface);border:1px solid var(--dc-border);border-radius:17px;overflow:hidden}
#desk-cluster .dc-detail[hidden]{display:none}
#desk-cluster .dc-detail-title{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:19px 22px;border-bottom:1px solid var(--dc-border)}
#desk-cluster .dc-detail-identity{display:flex;align-items:center;gap:12px;min-width:0}
#desk-cluster .dc-detail-emblem{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:11px;background:var(--dc-soft);color:var(--dc-gold);flex-shrink:0}
#desk-cluster .dc-detail-identity h2{font-size:16px;font-weight:600;margin:0;letter-spacing:-.3px}
#desk-cluster .dc-detail-subtitle{color:var(--dc-muted);font-size:12px;margin-top:2px}
#desk-cluster .dc-detail-actions{display:flex;align-items:center;gap:13px}
#desk-cluster .dc-close{font:inherit;color:var(--dc-muted);background:transparent;border:0;display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:9px}
#desk-cluster .dc-close:hover{background:var(--dc-hover);color:var(--dc-text)}
#desk-cluster .dc-detail-grid{display:grid;grid-template-columns:1fr 1.12fr 1fr;padding:23px 22px;gap:23px}
#desk-cluster .dc-detail-col{min-width:0}
#desk-cluster .dc-detail-col+.dc-detail-col{border-left:1px solid var(--dc-border);padding-left:23px}
#desk-cluster .dc-detail-heading{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--dc-faint);font-weight:600;margin:0 0 16px}
#desk-cluster .dc-detail-role{display:flex;align-items:flex-start;gap:10px;margin-bottom:17px}
#desk-cluster .dc-detail-role>svg{width:16px;height:16px;margin-top:2px;color:var(--dc-gold);flex-shrink:0}
#desk-cluster .dc-detail-role strong{font-weight:500;font-size:13px;display:block}
#desk-cluster .dc-detail-role small{display:block;color:var(--dc-muted);font-size:12px;margin-top:3px;overflow-wrap:anywhere}
#desk-cluster .dc-connection-row{display:flex;justify-content:space-between;gap:12px;margin-top:9px;font-size:12px;color:var(--dc-muted)}
#desk-cluster .dc-connection-row b{font-weight:500;color:var(--dc-text);text-align:right}
#desk-cluster .dc-stage{position:relative;display:grid;grid-template-columns:20px 1fr auto;gap:8px;align-items:center;padding:8px 0;font-size:12px;color:var(--dc-muted)}
#desk-cluster .dc-stage>svg{width:15px;height:15px}
#desk-cluster .dc-stage.active{color:var(--dc-text)}
#desk-cluster .dc-stage.active>svg{color:var(--dc-gold)}
#desk-cluster .dc-stage-status{font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-stage.active .dc-stage-status{color:var(--dc-gold)}
#desk-cluster .dc-work-note{margin-top:10px;font-size:12px;color:var(--dc-muted)}
#desk-cluster .dc-work-note strong{color:var(--dc-text);font-weight:500}
#desk-cluster .dc-sync-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;font-size:12px}
#desk-cluster .dc-sync-row small{font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-sync-state{display:flex;align-items:center;gap:6px;color:var(--dc-green);font-size:11px;white-space:nowrap}
#desk-cluster .dc-sync-state svg{width:13px;height:13px}
#desk-cluster .dc-sync-state.unknown{color:var(--dc-faint)}
#desk-cluster .dc-detail-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:13px 22px;background:var(--dc-hover);font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-detail-link{display:flex;align-items:center;gap:7px;color:var(--dc-gold);text-decoration:none;min-height:32px;font-size:12px}
#desk-cluster .dc-detail-link:hover{text-decoration:underline}
#desk-cluster .dc-detail-link svg{width:13px;height:13px}
@media(max-width:760px){ #desk-cluster .dc-detail-grid{grid-template-columns:1fr 1fr;gap:20px}#desk-cluster .dc-detail-col:last-child{grid-column:1/-1;border-left:0;border-top:1px solid var(--dc-border);padding:18px 0 0}#desk-cluster .dc-detail-col:last-child .dc-sync-rows{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}#desk-cluster .dc-sync-row{flex-wrap:wrap;gap:4px}}
@media(max-width:540px){ #desk-cluster .dc-detail-title{padding:15px}#desk-cluster .dc-detail-actions .dc-online{display:none}#desk-cluster .dc-detail-grid{grid-template-columns:1fr;padding:20px 15px;gap:20px}#desk-cluster .dc-detail-col+.dc-detail-col{border-left:0;border-top:1px solid var(--dc-border);padding:18px 0 0}#desk-cluster .dc-detail-col:last-child .dc-sync-rows{display:block}#desk-cluster .dc-sync-row{flex-wrap:nowrap}#desk-cluster .dc-detail-footer{padding:12px 15px}}
#desk-cluster .dc-services-title{margin:27px 0 11px;font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:var(--dc-faint);font-weight:600}
#desk-cluster .dc-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
#desk-cluster .dc-service{padding:17px 18px;background:var(--dc-surface);border:1px solid var(--dc-border);border-radius:14px;color:var(--dc-text);text-decoration:none;display:block}
#desk-cluster .dc-service:hover{background:var(--dc-hover);border-color:var(--dc-gold)}
#desk-cluster .dc-service-title{display:flex;align-items:center;gap:9px;font-weight:600}
#desk-cluster .dc-service-title svg{width:17px;height:17px;color:var(--dc-gold)}
#desk-cluster .dc-service p{font-size:12px;padding:8px 0 12px}
#desk-cluster .dc-service-bottom{display:flex;align-items:center;justify-content:space-between;color:var(--dc-faint);font-size:11px}
#desk-cluster .dc-service-bottom svg{width:13px;height:13px}
#desk-cluster .dc-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:21px;color:var(--dc-faint);font-size:11px}
#desk-cluster.dc-app[data-layout="rows"] .dc-nodes{display:flex;flex-direction:column;gap:10px}
#desk-cluster.dc-app[data-layout="rows"] .dc-node{display:grid;grid-template-columns:1.05fr 1.1fr 1.4fr 1.2fr 44px;align-items:center;border-radius:14px}
#desk-cluster.dc-app[data-layout="rows"] .dc-node-head{padding:19px 15px;align-items:flex-start}
#desk-cluster.dc-app[data-layout="rows"] .dc-roles{padding:0 8px;min-height:0}
#desk-cluster.dc-app[data-layout="rows"] .dc-activity{padding:17px 12px;min-height:0}
#desk-cluster.dc-app[data-layout="rows"] .dc-metrics{padding:15px 12px;border-top:0;gap:8px}
#desk-cluster.dc-app[data-layout="rows"] .dc-node-button{height:100%;padding:0 12px;border-top:0}
#desk-cluster.dc-app[data-layout="rows"] .dc-node-button span{display:none}
#desk-cluster .dc-offline .dc-dot{background:var(--dc-red)}
#desk-cluster .dc-offline .dc-task{color:var(--dc-red)}
#desk-cluster .dc-offline .dc-task svg{color:var(--dc-red)}
@media(max-width:760px){ #desk-cluster.dc-app{padding:0 18px 23px;min-height:740px}#desk-cluster .dc-node-head{padding:16px 13px}#desk-cluster .dc-roles{padding:0 13px;min-height:69px}#desk-cluster .dc-activity{padding:13px;min-height:113px}#desk-cluster .dc-metrics{padding:13px;gap:5px}#desk-cluster .dc-node-button{padding:10px 13px}#desk-cluster.dc-app[data-layout="rows"] .dc-node{grid-template-columns:1fr 1fr 1.1fr 40px}#desk-cluster.dc-app[data-layout="rows"] .dc-metrics{display:none}#desk-cluster .dc-service{padding:14px}}
@media(max-width:540px){ #desk-cluster .dc-top{padding-right:65px;align-items:flex-start;flex-direction:column;gap:4px}#desk-cluster .dc-intro{align-items:flex-start;flex-direction:column;gap:12px;padding-top:25px}#desk-cluster h1{font-size:25px}#desk-cluster .dc-nodes,#desk-cluster .dc-services{grid-template-columns:1fr}#desk-cluster .dc-roles{min-height:0;padding-bottom:0}#desk-cluster .dc-activity{min-height:0;padding:17px 13px}#desk-cluster .dc-node-head{padding:15px 13px 13px}#desk-cluster.dc-app[data-layout="rows"] .dc-node{grid-template-columns:1fr 44px}#desk-cluster.dc-app[data-layout="rows"] .dc-node-head{padding-bottom:10px}#desk-cluster.dc-app[data-layout="rows"] .dc-roles{grid-column:1;padding:0 15px}#desk-cluster.dc-app[data-layout="rows"] .dc-activity{grid-column:1;padding:12px 15px 16px}#desk-cluster.dc-app[data-layout="rows"] .dc-node-button{grid-column:2;grid-row:1/4}#desk-cluster .dc-service p{padding:7px 0}#desk-cluster .dc-detail-lines{flex-direction:column}}

body{margin:0;background:#100d08;color:#f3ead8;font-family:Inter,ui-sans-serif,system-ui,sans-serif;padding:20px 14px}#desk-cluster{width:min(1120px,100%);margin:auto}#desk-cluster button{cursor:pointer}#desk-cluster .dc-brand{color:inherit;text-decoration:none}#desk-cluster .dc-mark svg{width:20px;height:20px}#desk-cluster .dc-events{margin-top:24px;background:var(--dc-surface);border:1px solid var(--dc-border);border-radius:17px;overflow:hidden}#desk-cluster .dc-events-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:19px 22px;border-bottom:1px solid var(--dc-border)}#desk-cluster .dc-events-head h2{font-size:15px;font-weight:600;margin:0 0 4px}#desk-cluster .dc-events-head p{font-size:12px}#desk-cluster .dc-events-toggle{font:inherit;font-size:12px;color:var(--dc-gold);border:0;background:transparent;padding:10px 0;white-space:nowrap;min-height:44px}#desk-cluster .dc-event{padding:14px 22px;display:flex;align-items:center;gap:12px}#desk-cluster .dc-event+.dc-event{border-top:1px solid var(--dc-border)}#desk-cluster .dc-event-icon{display:flex;color:var(--dc-gold);flex-shrink:0}#desk-cluster .dc-event-content{min-width:0;flex:1;font-size:13px;overflow-wrap:anywhere}#desk-cluster .dc-event-content small{display:block;color:var(--dc-faint);font-size:11px;margin-top:3px}#desk-cluster .dc-event time{font-size:11px;color:var(--dc-faint);font-variant-numeric:tabular-nums;white-space:nowrap}#desk-cluster .dc-empty{padding:24px 22px;font-size:12px}#desk-cluster .dc-task{flex-wrap:wrap;overflow-wrap:anywhere}#desk-cluster .dc-activity{min-height:115px}#desk-cluster .dc-node-button:focus-visible,#desk-cluster a:focus-visible,#desk-cluster button:focus-visible{outline:2px solid var(--dc-gold);outline-offset:3px}#desk-cluster .dc-detail-heading{overflow-wrap:anywhere}#desk-cluster .dc-services-title{font-size:11px}#desk-cluster .dc-detail-link{min-height:44px}@media(max-width:540px){body{padding:0}#desk-cluster{border-radius:0}#desk-cluster .dc-events-head,#desk-cluster .dc-event{padding-left:15px;padding-right:15px}#desk-cluster .dc-summary{gap:10px 15px}#desk-cluster .dc-activity{min-height:0}}
#desk-cluster .dc-services{grid-template-columns:repeat({{ 3 if desk_network_enabled | default(false) | bool else (5 if desk_vpn_ui_enabled | default(false) | bool else 4) }},minmax(0,1fr))}#desk-cluster .dc-client-service{min-width:0}#desk-cluster .dc-client-service .dc-service{width:100%;height:100%;text-align:left;font-family:inherit}#desk-cluster .dc-client-disabled{cursor:default;opacity:.65}#desk-cluster .dc-client-disabled:hover{background:var(--dc-surface);border-color:var(--dc-border)}#desk-cluster .dc-client-status{display:flex;align-items:center;gap:5px}@media(max-width:900px){ #desk-cluster .dc-services{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){ #desk-cluster .dc-services{grid-template-columns:1fr}}
#desk-cluster .dc-service{display:flex;flex-direction:column;min-height:120px}#desk-cluster .dc-service-bottom{margin-top:auto;padding-top:8px}#desk-cluster .dc-client-service{display:flex}#desk-cluster .dc-client-service .dc-service{flex:1}@media(max-width:540px){ #desk-cluster .dc-service{min-height:112px}}

#desk-cluster .dc-reboot{display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:7px 11px;border:1px solid var(--dc-border);border-radius:8px;background:transparent;color:var(--dc-muted);font:inherit;font-size:12px;cursor:pointer}#desk-cluster .dc-reboot:hover:not(:disabled){border-color:var(--dc-gold);color:var(--dc-text)}#desk-cluster .dc-reboot:disabled{opacity:.45;cursor:not-allowed}#desk-cluster .dc-detail-links{display:flex;align-items:center;gap:15px;flex-wrap:wrap}#desk-cluster .dc-operation{margin:14px 0 0;padding:12px 15px;background:var(--dc-surface);border:1px solid var(--dc-border);border-radius:12px;font-size:12px;color:var(--dc-muted)}#desk-cluster .dc-operation strong{color:var(--dc-text)}#desk-cluster dialog{width:min(440px,calc(100% - 32px));max-height:calc(100% - 32px);overflow:auto;background:var(--dc-surface);color:var(--dc-text);border:1px solid var(--dc-border);border-radius:16px;padding:23px;font:14px/1.5 Inter,ui-sans-serif,system-ui,sans-serif}#desk-cluster dialog::backdrop{background:rgba(0,0,0,.6)}#desk-cluster dialog h2{margin:0 0 10px;font-size:19px}#desk-cluster dialog p{margin:8px 0}#desk-cluster .dc-confirm-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}#desk-cluster .dc-confirm-primary{background:var(--dc-gold);color:var(--dc-bg);border-color:var(--dc-gold)}#desk-cluster .dc-confirm-note{font-size:12px;color:var(--dc-faint)}
#desk-cluster .dc-dns{margin:18px 0;border:1px solid var(--dc-border);border-radius:17px;background:var(--dc-surface);overflow:hidden}#desk-cluster .dc-dns-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--dc-border)}#desk-cluster .dc-dns-head h2{font-size:15px;margin:0 0 3px}#desk-cluster .dc-dns-head p{font-size:12px;margin:0}#desk-cluster .dc-dns-grid{display:grid;grid-template-columns:1fr 1fr 2fr;gap:20px;padding:16px 20px}#desk-cluster .dc-dns-grid small,#desk-cluster .dc-dns-grid span{display:block;color:var(--dc-faint);font-size:12px}#desk-cluster .dc-dns-grid strong{display:block;font-size:13px;margin:5px 0}#desk-cluster .dc-dns-warning{color:var(--dc-red)}#desk-cluster .dc-detail-links{flex-wrap:wrap}@media(max-width:540px){ #desk-cluster .dc-dns-grid{grid-template-columns:1fr 1fr;gap:14px}#desk-cluster .dc-dns-grid>div:last-child{grid-column:1/-1}#desk-cluster .dc-dns-head{align-items:flex-start;flex-direction:column}}
#desk-cluster .dc-topology{position:relative}
#desk-cluster .dc-topology-endpoints{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
#desk-cluster .dc-endpoint{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;background:var(--dc-surface);border:1px solid var(--dc-border);border-radius:14px;min-width:0;text-align:left;font:inherit;color:var(--dc-text);width:100%}
#desk-cluster .dc-endpoint:hover{background:var(--dc-hover)}
#desk-cluster .dc-endpoint[aria-pressed="true"]{border-color:var(--dc-muted)}
#desk-cluster .dc-endpoint[data-dimmed="true"]{opacity:.5}
#desk-cluster .dc-endpoint>[data-icon]{color:var(--dc-gold);flex-shrink:0;margin-top:3px}
#desk-cluster .dc-endpoint[data-service="dns"]>[data-icon]{color:var(--dc-green)}
#desk-cluster .dc-endpoint[data-service="vpn"]>[data-icon]{color:var(--dc-vpn)}
#desk-cluster .dc-endpoint-title{display:block;font-size:14px;font-weight:600;margin:0 0 3px}
#desk-cluster .dc-endpoint-description{display:block;font-size:12px;color:var(--dc-muted)}
#desk-cluster .dc-endpoint-vip{display:block;font:11px/1.5 ui-monospace,monospace;color:var(--dc-faint);margin-top:5px}
#desk-cluster .dc-endpoint-owner.dc-dns-warning{color:var(--dc-red)}
#desk-cluster .dc-endpoint-owner{display:block;margin-top:6px;font-size:11px;color:var(--dc-faint);overflow-wrap:anywhere}
#desk-cluster .dc-topology-wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
#desk-cluster .dc-topology-wires path{fill:none;stroke:var(--dc-gold);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round}
#desk-cluster .dc-topology-wires .dc-wire-dns{stroke:var(--dc-green)}
#desk-cluster .dc-topology-wires .dc-wire-vpn{stroke:var(--dc-vpn)}
#desk-cluster .dc-topology-wires .dc-wire-halo{stroke:var(--dc-bg);stroke-width:6;stroke-dasharray:none;opacity:1}
#desk-cluster .dc-topology-wires .dc-wire-pool{stroke-dasharray:4 5;opacity:.65}
#desk-cluster .dc-topology .dc-nodes{position:relative;z-index:1;margin-top:72px}
#desk-cluster .dc-node-dns{padding:9px 19px;border-top:1px solid var(--dc-border);font-size:11px;color:var(--dc-faint);display:flex;align-items:center;gap:6px}
#desk-cluster .dc-node-dns.eligible{color:var(--dc-green)}
#desk-cluster .dc-node-dns>svg{width:12px;height:12px}
#desk-cluster .dc-worker-active .dc-task{color:var(--dc-gold)}
#desk-cluster .dc-worker-active .dc-task>svg{animation:dc-worker-pulse 1.8s ease-in-out infinite}
#desk-cluster .dc-topology-legend{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:13px;font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-topology-legend span{display:flex;gap:7px;align-items:center}
#desk-cluster .dc-topology-key{width:19px;height:0;border-top:1.5px solid var(--dc-gold)}
#desk-cluster .dc-topology-key.dns{border-color:var(--dc-green)}
#desk-cluster .dc-topology-key.vpn{border-color:var(--dc-vpn)}
#desk-cluster .dc-topology-key.pool{border-color:var(--dc-muted);border-top-style:dashed}
#desk-cluster .dc-topology-legend [hidden]{display:none}
#desk-cluster .dc-topology-hint{margin-left:auto}
#desk-cluster .dc-topology-key.worker{border:0;width:6px;height:6px;border-radius:50%;background:var(--dc-gold)}
#desk-cluster .dc-dns summary{padding:13px 18px;display:flex;justify-content:space-between;align-items:center;gap:12px;list-style:none;cursor:pointer;font-size:12px}
#desk-cluster .dc-dns summary::-webkit-details-marker{display:none}
#desk-cluster .dc-dns summary>span:first-child{display:flex;gap:8px;align-items:center;color:var(--dc-text)}
#desk-cluster .dc-dns summary svg{width:14px;height:14px;color:var(--dc-gold)}
#desk-cluster .dc-dns[open] summary{border-bottom:1px solid var(--dc-border)}
#desk-cluster .dc-dns[open] summary svg{transform:rotate(90deg)}
#desk-cluster .dc-dns-note{padding:0 20px 15px;font-size:11px;color:var(--dc-faint)}
@keyframes dc-worker-pulse{50%{opacity:.35}}
@media(prefers-reduced-motion:reduce){ #desk-cluster .dc-worker-active .dc-task>svg{animation:none}}
#desk-cluster[data-paused="true"] .dc-worker-active .dc-task>svg{animation-play-state:paused}
@media(max-width:540px){ #desk-cluster .dc-topology-endpoints{grid-template-columns:1fr;gap:8px;padding-left:22px}#desk-cluster .dc-endpoint{padding:12px 10px;gap:7px}#desk-cluster .dc-endpoint>[data-icon]{width:14px;height:14px}#desk-cluster .dc-endpoint-description{font-size:11px}#desk-cluster .dc-endpoint-owner{font-size:11px}#desk-cluster .dc-topology .dc-nodes{margin-top:38px;padding-left:22px}#desk-cluster .dc-node-dns{padding:9px 13px}#desk-cluster .dc-dns summary{align-items:flex-start;flex-wrap:wrap}#desk-cluster .dc-topology-legend{gap:9px 14px}}
#desk-cluster .dc-timeline .dc-events-head{align-items:flex-start}
#desk-cluster .dc-events-scroll{max-height:340px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;scrollbar-width:thin;scrollbar-color:var(--dc-border) transparent}
#desk-cluster .dc-episode{border-bottom:1px solid var(--dc-border)}
#desk-cluster .dc-episode:last-child{border-bottom:0}
#desk-cluster .dc-episode>summary{display:flex;align-items:center;gap:12px;padding:14px 22px;min-height:68px;list-style:none;cursor:pointer}
#desk-cluster .dc-episode>summary::-webkit-details-marker{display:none}
#desk-cluster .dc-episode>summary:hover{background:var(--dc-hover)}
#desk-cluster .dc-episode .dc-event-content>span{font-weight:500}
#desk-cluster .dc-episode time{font-size:11px;color:var(--dc-faint);font-variant-numeric:tabular-nums;white-space:nowrap}
#desk-cluster .dc-event-icon.good{color:var(--dc-green)}
#desk-cluster .dc-event-icon.warning{color:var(--dc-red)}
#desk-cluster .dc-event-chevron{display:flex;color:var(--dc-faint)}
#desk-cluster .dc-event-chevron svg{width:12px;height:12px}
#desk-cluster .dc-episode[open]>summary .dc-event-chevron{transform:rotate(90deg)}
#desk-cluster .dc-episode-steps{padding:0 22px 17px 47px}
#desk-cluster .dc-episode-step{position:relative;display:flex;gap:12px;padding:9px 0;font-size:12px}
#desk-cluster .dc-episode-step:not(:last-child)::before{content:'';position:absolute;left:4px;top:20px;bottom:-11px;width:1px;background:var(--dc-border)}
#desk-cluster .dc-step-dot{position:relative;width:9px;height:9px;margin-top:5px;background:var(--dc-faint);border-radius:50%;flex-shrink:0}
#desk-cluster .dc-episode-step.good .dc-step-dot{background:var(--dc-green)}
#desk-cluster .dc-episode-step.warning .dc-step-dot{background:var(--dc-red)}
#desk-cluster .dc-episode-step>div{min-width:0;overflow-wrap:anywhere}
#desk-cluster .dc-step-change{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:5px;color:var(--dc-muted)}
#desk-cluster .dc-step-change>span:first-child{color:var(--dc-faint)}
#desk-cluster .dc-step-change svg{width:12px;height:12px;transform:rotate(45deg)}
#desk-cluster .dc-step-meta,#desk-cluster .dc-step-source{display:block;font-size:11px;color:var(--dc-faint);margin-top:5px}
#desk-cluster .dc-step-context{font-size:11px;color:var(--dc-muted);margin:6px 0 0}
#desk-cluster .dc-event-day{padding:11px 22px 3px;font-size:10px;color:var(--dc-faint);text-transform:uppercase;letter-spacing:1px}
#desk-cluster .dc-events-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 22px;border-top:1px solid var(--dc-border)}
#desk-cluster .dc-events-footer small,#desk-cluster .dc-event-latest{font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-event-latest{padding:14px 22px}
#desk-cluster .dc-timeline [hidden]{display:none}
@media(max-width:540px){ #desk-cluster .dc-episode>summary{padding:13px 15px;flex-wrap:wrap;gap:8px}#desk-cluster .dc-episode .dc-event-content{flex-basis:calc(100% - 65px)}#desk-cluster .dc-episode>summary time{margin-left:24px;order:4}#desk-cluster .dc-episode-steps{padding:0 15px 16px 35px}#desk-cluster .dc-event-day,#desk-cluster .dc-events-footer,#desk-cluster .dc-event-latest{padding-left:15px;padding-right:15px}#desk-cluster .dc-events-scroll{max-height:320px}}

#desk-cluster .dc-ha-stages{display:flex;align-items:center;flex-wrap:wrap;gap:7px;padding:10px 0 8px}
#desk-cluster .dc-ha-stage{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--dc-faint)}
#desk-cluster .dc-ha-stage.done{color:var(--dc-green)}#desk-cluster .dc-ha-stage.current{color:var(--dc-gold)}
#desk-cluster .dc-ha-stage svg{width:12px;height:12px}#desk-cluster .dc-ha-separator{color:var(--dc-faint);opacity:.6}
#desk-cluster .dc-ha-milestones{list-style:none;margin:0;padding:0}
#desk-cluster .dc-ha-milestones li{display:grid;grid-template-columns:72px 1fr;gap:12px;padding:7px 0;font-size:12px;overflow-wrap:anywhere}
#desk-cluster .dc-ha-milestones time{color:var(--dc-faint);font-size:11px}
#desk-cluster .dc-ha-source{display:block;font-size:11px;color:var(--dc-faint);border-top:1px solid var(--dc-border);margin-top:12px;padding-top:12px}
#desk-cluster .dc-ha-note{margin:0 0 10px;color:var(--dc-muted);font-size:11px;overflow-wrap:anywhere}
#desk-cluster .dc-ha-owners{display:flex;align-items:center;gap:15px;padding:9px 0 12px}
#desk-cluster .dc-ha-owners>span{min-width:0}#desk-cluster .dc-ha-owners strong{font-size:12px;font-weight:500}
#desk-cluster .dc-ha-owners small{display:block;font-size:11px;color:var(--dc-faint);margin-top:3px}
#desk-cluster .dc-ha-owners>svg{width:14px;height:14px;transform:rotate(45deg)}
#desk-cluster .dc-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
#desk-cluster .dc-network-scan{margin:14px 0;padding:13px;border:1px solid var(--dc-border);border-radius:10px;font-size:12px;line-height:1.5}#desk-cluster .dc-network-scan-heading,#desk-cluster .dc-network-scan-row{display:flex;align-items:center;justify-content:space-between;gap:12px}#desk-cluster .dc-network-scan-heading{margin-bottom:9px}#desk-cluster .dc-network-scan-heading>span{color:var(--dc-green)}#desk-cluster .dc-network-scan-heading .dc-scan-muted{color:var(--dc-muted)}#desk-cluster .dc-network-scan-row b{font-size:12px;text-align:right}#desk-cluster .dc-network-scan small{display:block;overflow-wrap:anywhere;color:var(--dc-muted);margin:4px 0 8px}#desk-cluster .dc-network-data-age{border-top:1px solid var(--dc-border);padding-top:8px}#desk-cluster .dc-network-scan button{margin-top:3px;max-width:100%;white-space:normal}
</style></head><body><main id="desk-cluster" class="dc-app">
<header class="dc-top"><a class="dc-brand" href="/" aria-label="Desk Cluster home"><span class="dc-mark" data-icon="layers"></span>Desk Cluster</a><span class="dc-address" id="address"></span></header>
<div class="dc-intro"><div><div class="dc-eyebrow">Cluster overview</div><h1>Three nodes. One home.</h1><p>Ownership, activity and health at a glance.</p></div><span class="dc-online" id="online">Connecting…</span></div>
<div class="dc-summary" id="summary"></div>
<section id="topology" class="dc-topology" aria-label="Live cluster topology">
<div class="dc-topology-endpoints">
<button type="button" id="topology-xiaozhi" class="dc-endpoint" data-service="xiaozhi" aria-pressed="false" aria-controls="topology-links"><span data-icon="bot"></span><span><strong class="dc-endpoint-title">Xiaozhi</strong><span class="dc-endpoint-description">Control plane · /xiaozhi/</span><span class="dc-endpoint-vip">VIP {{ dashboard_management_vip | default((route_before.stdout | from_json).vip if route_before is defined else (desk_ui_snapshot | default({})).get('vip', 'Shared UI')) }}</span><span class="dc-endpoint-owner" id="topology-xiaozhi-owner">Owner unconfirmed</span></span></button>
<button type="button" id="topology-dns" class="dc-endpoint" data-service="dns" aria-pressed="false" aria-controls="topology-links"><span data-icon="shield"></span><span><strong class="dc-endpoint-title">DNS</strong><span class="dc-endpoint-description">Resolver · IPv4 + IPv6</span><span class="dc-endpoint-vip">VIP {{ desk_dns_vip | default('192.168.1.250') }} · {{ desk_dns_ipv6_vip | default('fe80::250') }}</span><span class="dc-endpoint-owner" id="topology-dns-owner">Owner unconfirmed</span></span></button>
<button type="button" id="topology-vpn" class="dc-endpoint" data-service="vpn" aria-pressed="false" aria-controls="topology-links"><span data-icon="network"></span><span><strong class="dc-endpoint-title">VPN</strong><span class="dc-endpoint-description">WireGuard · {{ desk_vpn_endpoint | default("vpn.huynm.dev") }}:51820</span><span class="dc-endpoint-vip">VIP {{ desk_vpn_vip | default('192.168.1.254') }}</span><span class="dc-endpoint-owner" id="topology-vpn-owner">Owner unconfirmed</span></span></button>
</div>
<svg id="topology-links" class="dc-topology-wires" role="img" aria-label="Service owners and confirmed backend readiness"></svg>
<div class="dc-nodes" id="nodes"></div>
</section>
<div class="dc-topology-legend" aria-label="Topology legend"><span><i class="dc-topology-key"></i>Xiaozhi owner</span><span><i class="dc-topology-key dns"></i>DNS owner</span><span><i class="dc-topology-key vpn"></i>VPN owner</span><span id="topology-pool-key" hidden><i class="dc-topology-key pool"></i><span id="topology-pool-label"></span></span><span id="topology-worker-key" hidden><i class="dc-topology-key worker"></i>Voice worker active</span><span class="dc-topology-hint" id="topology-hint">Select a service to trace its connections</span></div>
<div id="node-operation" class="dc-operation" role="status" hidden></div>
<div id="details" hidden></div>
<details class="dc-dns" id="dns-health" aria-label="DNS health"><summary><span><span data-icon="arrow"></span>DNS health</span><span id="dns-health-summary">Waiting for telemetry…</span></summary><div id="dns-health-content"></div></details>
<h2 class="dc-services-title">Services</h2><nav class="dc-services" aria-label="Cluster services">
{% if desk_homeassistant_enabled | default(false) | bool %}
<a class="dc-service" href="http://{{ dashboard_management_vip | default('192.168.1.186') }}:8123/"><div class="dc-service-title"><span data-icon="layers"></span>Home Assistant</div><p id="homeassistant-checkpoint">Recovery from the last clean checkpoint.</p><div class="dc-service-bottom"><span id="homeassistant-status">Checking Core…</span><span data-icon="arrow"></span></div></a>
{% endif %}
<a class="dc-service" href="/xiaozhi/"><div class="dc-service-title"><span data-icon="bot"></span>Xiaozhi</div><p>Providers, memory, soundbank and voice logs.</p><div class="dc-service-bottom"><span>/xiaozhi/</span><span data-icon="arrow"></span></div></a>
<div id="client-service" class="dc-client-service"><button type="button" class="dc-service dc-client-disabled" disabled><div class="dc-service-title">Xiaozhi Client</div><p>Desk Robot · Web Control</p><div class="dc-service-bottom"><span>Checking device…</span></div></button></div>
<a class="dc-service" href="/dns/"><div class="dc-service-title"><span data-icon="shield"></span>DNS</div><p>AdGuard Home · Filtering, clients and query logs.</p><div class="dc-service-bottom"><span>/dns/</span><span data-icon="arrow"></span></div></a>
<a class="dc-service" href="/monitor/"><div class="dc-service-title"><span data-icon="activity"></span>Monitoring</div><p>Beszel · CPU, memory, temperatures and services.</p><div class="dc-service-bottom"><span>/monitor/</span><span data-icon="arrow"></span></div></a>
<a class="dc-service" href="http://{{ dashboard_management_vip | default('192.168.1.186') }}:2586/" aria-label="Open NTFY"><div class="dc-service-title"><span data-icon="activity"></span>NTFY</div><p>Read, publish and customize notifications.</p><div class="dc-service-bottom"><span id="ntfy-status">Owner unconfirmed</span><span data-icon="arrow"></span></div></a>
{% if desk_vpn_ui_enabled | default(false) | bool %}
<a class="dc-service" href="/vpn/"><div class="dc-service-title"><span data-icon="network"></span>VPN</div><p>WireGuard · Clients, QR profiles and secure LAN access.</p><div class="dc-service-bottom"><span>/vpn/</span><span data-icon="arrow"></span></div></a>
{% endif %}

{% if desk_network_enabled | default(false) | bool %}
<a class="dc-service" href="/network/"><div class="dc-service-title"><span data-icon="network"></span>Network</div><p>NetAlertX · LAN devices, presence and discovery.</p><div class="dc-service-bottom"><span>/network/</span><span data-icon="arrow"></span></div></a>
{% endif %}
</nav>

<dialog id="reboot-dialog" aria-labelledby="reboot-title"><h2 id="reboot-title">Reboot node</h2><div id="reboot-description"></div><p class="dc-confirm-note">New jobs are paused. Existing jobs and conversations get up to four minutes to finish, then VIPs move to healthy peers. On timeout maintenance is cancelled without forcing a reboot. Maintenance expires after ten minutes; admission and VIP eligibility recover automatically.</p><div class="dc-confirm-actions"><button id="reboot-cancel" class="dc-reboot" type="button">Cancel</button><button id="reboot-confirm" class="dc-reboot dc-confirm-primary" type="button" disabled>Reboot node</button></div></dialog>
<section class="dc-events dc-timeline" aria-label="Cluster timeline"><header class="dc-events-head"><div><h2>Cluster timeline</h2><p id="event-subtitle">Ownership, maintenance and recovery.</p></div><button id="event-collapse" type="button" class="dc-events-toggle" aria-expanded="true" aria-controls="event-body">Collapse</button></header><div id="event-latest" class="dc-event-latest" hidden></div><div id="event-body"><div id="events" class="dc-events-scroll" role="region" aria-label="Scrollable cluster timeline"><p class="dc-empty">Waiting for cluster status…</p></div><footer class="dc-events-footer"><small id="event-count">Observed history</small><button id="event-toggle" type="button" class="dc-events-toggle" hidden>View all</button></footer></div></section>
<footer class="dc-foot"><span>Trusted LAN access · One address for all services</span><span id="updated" role="status">Connecting to cluster…</span></footer>
</main>
<script>
'use strict';
const membership={{ dashboard_members | to_json }};
const firmwareURL={{ desk_dashboard_client_url | default('') | to_json }};
const networkEnabled={{ desk_network_enabled | default(false) | to_json }};
const nodeControlEnabled={{ desk_node_control_enabled | default(false) | to_json }};
{% raw %}
const root=document.getElementById('desk-cluster');
const state={selectedService:null,selected:null,showAll:false,eventsClosed:false,openEvents:new Set(),snapshot:null,unavailable:false};
const iconPaths={layers:'M12 3 3 8l9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',server:'M4 3h16v7H4zM4 14h16v7H4zM7 6h.01M7 17h.01',crown:'m3 6 4 4 5-7 5 7 4-4-2 14H5L3 6Z',sparkles:'m12 3 2.8 6.2L21 12l-6.2 2.8L12 21l-2.8-6.2L3 12l6.2-2.8L12 3Z',volume:'m11 5-6 4H2v6h3l6 4V5Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14',mic:'M9 4a3 3 0 0 1 6 0v8a3 3 0 0 1-6 0V4Zm-3 7v1a6 6 0 0 0 12 0v-1M12 18v4M8 22h8',network:'M9 2h6v6H9zM2 16h6v6H2zM16 16h6v6h-6zM12 8v4M5 16v-4h14v4',pause:'M8 5v14M16 5v14',shield:'m12 2 8 3v6c0 5-8 11-8 11S4 16 4 11V5l8-3Zm-4 10 3 3 5-6',check:'m5 12 4 4L19 6',arrow:'M7 17 17 7M7 7h10v10',x:'m6 6 12 12M6 18 18 6',activity:'M2 12h4l3-9 6 18 3-9h4',bot:'M6 8h12a2 2 0 0 1 2 2v9H4v-9a2 2 0 0 1 2-2ZM12 8V3M9 12h.01M15 12h.01M9 16h6',sync:'M4 9a8 8 0 0 1 14-4l2 2M20 3v4h-4M20 15A8 8 0 0 1 6 20l-2-2M4 22v-4h4',alert:'m12 3 10 18H2L12 3ZM12 9v5M12 17h.01',clock:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM12 6v6l4 2'};
function icon(name){return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${iconPaths[name]||iconPaths.server}"/></svg>`;}
function esc(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function finite(v){return typeof v==='number'&&Number.isFinite(v);}
function metric(v,unit){return finite(v)?esc(v.toFixed(unit==='°C'?1:0))+unit:'—';}
function blank(m){return {id:m.id,ip:m.management,online:false,vip:{},activity:{},sessions:{},components:{},configuration:{}};}
function fresh(n){return !state.unavailable&&n.online===true&&Date.now()-Date.parse(n.observed_at)<=20000;}
function live(n){if(fresh(n))return n;return {...blank({id:n.id,management:n.ip}),observed_at:n.observed_at};}
function workerName(kind){return {asr:'ASR',llm:'LLM / VLM',tts:'TTS'}[kind];}
function task(n){
 if(!fresh(n))return ['alert','Telemetry unavailable','Waiting for the node to respond'];
 const active=['asr','llm','tts'].filter(k=>finite(n.activity[k])&&n.activity[k]>0);
 if(active.length)return [active.length===1?{asr:'mic',llm:'sparkles',tts:'volume'}[active[0]]:'activity',active.map(workerName).join(' + '),active.map(k=>`${n.activity[k]} ${k.toUpperCase()} job${n.activity[k]===1?'':'s'}`).join(' · ')];
 if(['asr','llm','tts'].some(k=>!finite(n.activity[k])))return ['alert','Worker status unavailable','Activity has not been confirmed'];
 if(finite(n.dns_queries_per_second)&&n.dns_queries_per_second>0)return ['network','DNS · Serving',`${n.dns_queries_per_second.toFixed(1)} queries/s · ${n.core>0?'conversation idle':'voice idle'}`];
 return ['pause','Voice · Idle',n.core>0?'Conversation open · ready for input':'No active voice jobs'];
}
function monitoringPreferred(){const owners=(state.snapshot?.nodes||[]).filter(x=>fresh(x)&&x.vip?.xiaozhi===true);return owners.length===1?owners[0].monitoring_preferred:null;}
// NTFY shares the management VIP; replica readiness does not elect an owner.
function ntfyOwner(){const owners=(state.snapshot?.nodes||[]).filter(n=>fresh(n)&&n.vip?.xiaozhi===true);return owners.length===1?owners[0].id:owners.length>1?'Conflict':'Unconfirmed';}
function roles(n){const entries=[];if(n.vip.xiaozhi===true)entries.push(['Xiaozhi VIP','xiaozhi']);if(fresh(n)&&n.vip.xiaozhi===true)entries.push([ntfyOwner()===n.id?'NTFY owner':'NTFY ownership unconfirmed','ntfy']);if(n.vip.dns===true)entries.push(['DNS VIP','dns']);if(n.vip.vpn===true)entries.push(['VPN VIP','vpn']);const preferred=monitoringPreferred();if(fresh(n)&&preferred===n.id)entries.push(['Monitoring preferred','monitoring']);if(fresh(n)&&n.service_roles?.network)entries.push([n.service_roles.network==='trial'?'Network trial':'Network owner','network']);if(fresh(n)&&n.homeassistant&&n.homeassistant.state!=='standby')entries.push(['Home Assistant','homeassistant']);if(n.mqtt>0)entries.push([`MQTT · ${n.mqtt}`,false]);if(n.core>0)entries.push([`Core · ${n.core}`,false]);if(!entries.length)entries.push([fresh(n)?'Voice worker':'Unavailable',false]);return entries.map(([label,owner])=>`<span class="dc-role ${owner?`owner ${owner}`:''}">${owner?icon(owner==='monitoring'?'activity':owner==='network'?'network':owner==='homeassistant'?'layers':'crown'):''}${esc(label)}</span>`).join('');}
function configSummary(nodes,key){let highest=null;for(const n of nodes){const r=n.configuration[key]?.revision;if(finite(r)&&(highest===null||r>highest))highest=r;}return {ready:nodes.filter(n=>fresh(n)&&highest!==null&&n.configuration[key]?.revision===highest&&n.configuration[key]?.state==='synced').length,revision:highest};}
function nodeMarkup(n,model){const [symbol,title,subtitle]=task(n);const active=fresh(n)&&['asr','llm','tts'].some(k=>finite(n.activity[k])&&n.activity[k]>0);const [dnsClass,dnsLabel]=dnsEligibility(n,model);return `<article class="dc-node ${fresh(n)?'':'dc-offline'} ${active?'dc-worker-active':''}" data-selected="${state.selected===n.id}"><div class="dc-node-head"><div><div class="dc-node-name">${esc(n.id)}</div><div class="dc-ip">${esc(n.ip)}</div></div><i class="dc-dot" aria-label="${fresh(n)?'Online':'Unavailable'}"></i></div><div class="dc-roles">${roles(n)}</div><div class="dc-activity"><div class="dc-label">Current activity</div><div class="dc-task">${icon(symbol)}${esc(title)}</div><div class="dc-task-meta">${esc(subtitle)}</div></div><div class="dc-metrics">${[['CPU',n.cpu,'%'],['Memory',n.memory,'%'],['Temp',n.temperature,'°C']].map(([label,value,unit])=>`<div class="dc-metric"><small>${label}</small><strong>${metric(value,unit)}</strong>${unit==='%'?`<div class="dc-bar"><i style="width:${finite(value)?Math.min(100,Math.max(0,value)):0}%"></i></div>`:''}</div>`).join('')}</div><div class="dc-node-dns ${dnsClass}">${icon('shield')}${esc(dnsLabel)}</div><button type="button" class="dc-node-button" data-node="${esc(n.id)}" aria-expanded="${state.selected===n.id}" aria-controls="details"><span>View node details</span>${icon('arrow')}</button></article>`;}
function currentNetwork(n){const info=n.network;const age=Date.now()-Date.parse(info?.observed_at);return fresh(n)&&info&&Number.isFinite(age)&&age>=-5000&&age<15000?info:null;}
function compareNetworkRevision(a,b){return a.term-b.term||a.node.localeCompare(b.node)||a.sequence-b.sequence;}
function networkDetail(n){
 const info=currentNetwork(n);if(!info)return {role:'Network state unavailable',scope:'Waiting for fresh service metadata',revision:'Revision unavailable',label:'Unknown',ok:false};
 const role={active:'Network owner',standby:'Network standby',starting:'Network starting'}[info.state]||'Network state unavailable';
 const revision=info.revision;const observed=(state.snapshot?.nodes||[]).map(currentNetwork).filter(Boolean).map(x=>x.revision).filter(Boolean);const newest=observed.sort(compareNetworkRevision).at(-1);
 const ok=info.sync==='synced'&&info.voter_ready===true&&revision&&(!newest||compareNetworkRevision(revision,newest)===0);
 return {role,scope:info.state==='standby'?`Standby · ${info.subnet}`:`LAN ${info.subnet} · ${info.scan_minutes>0?`scan every ${info.scan_minutes} min`:info.scan_schedule?`schedule ${info.scan_schedule}`:'scan schedule unavailable'}`,revision:revision?`checkpoint ${revision.term}.${revision.sequence}`:'Revision unavailable',label:info.voter_ready!==true?'Warming up':ok?'Synced':'Pending',ok:!!ok};
}
const networkScanState={value:null,at:0,loading:false,sending:false,notice:'',unavailable:false};
const scanPhases={idle:'Waiting for a scan',queued:'Queued',selecting:'Selecting worker',running:'Scanning',retrying:'Trying another worker',completed:'Importing results',importing:'Importing results',complete:'Complete',cached:'Cached',failed:'Unavailable'};
const activeScanPhases=new Set(['queued','selecting','running','retrying','completed','importing']);
function networkScanMarkup(n){
 if(!networkEnabled||currentNetwork(n)?.state!=='active')return '';
 const value=networkScanState.value;const valid=!networkScanState.unavailable&&value?.owner===n.id&&Date.now()-networkScanState.at<15000;
 const arp=valid?value.scans.arp:{},mdns=valid?value.scans.mdns:{},data=valid?value.inventory:{};
 const busy=networkScanState.sending||valid&&activeScanPhases.has(arp.phase);
 const phase=scanPhases[arp.phase]||'Status unavailable';
 const age=Number.isFinite(data.age_seconds)?elapsedText(data.age_seconds*1000):null;
 const freshness=data.state==='fresh'?'Fresh':data.state==='stale'?'Stale':'Unknown';
 let result=arp.message||(Number.isInteger(arp.devices)?`${arp.devices} devices${Number.isFinite(arp.wall_seconds)?` · ${arp.wall_seconds.toFixed(1)}s`:''}`:'No completed observation');
 if(arp.phase==='complete'&&Number.isInteger(arp.new_devices))result+=` · ${arp.new_devices} new, ${arp.ip_changes||0} IP changes`;
 return `<section class="dc-network-scan" aria-label="Network discovery"><div class="dc-network-scan-heading"><strong>LAN discovery</strong><span class="${data.state==='fresh'?'':'dc-scan-muted'}">${esc(freshness)}</span></div><div class="dc-network-scan-row"><span>ARP</span><b>${esc(phase)}</b></div><small>${esc(arp.worker?`Worker · ${arp.worker}`:'Worker unconfirmed')}</small><small>${esc(result)}</small><div class="dc-network-scan-row"><span>mDNS</span><span>${esc(scanPhases[mdns.phase]||'Unknown')}</span></div><small class="dc-network-data-age">${esc(age?`Data imported ${age} ago${data.state==='stale'?' · showing last known presence':''}`:'Last import unavailable · freshness unknown')}</small>${networkScanState.notice?`<small role="status">${esc(networkScanState.notice)}</small>`:''}<button type="button" class="dc-reboot" data-network-scan ${busy?'disabled':''}>${icon('sync')}${esc(networkScanState.sending?'Queuing…':busy?phase:'Scan now')}</button></section>`;
}
async function pollNetworkScan(){
 if(!networkEnabled||document.hidden||networkScanState.loading||!state.selected)return;
 const owner=(state.snapshot?.nodes||[]).find(n=>currentNetwork(n)?.state==='active');if(!owner||state.selected!==owner.id)return;
 networkScanState.loading=true;
 try{
  const r=await fetch('/network/desk/scan-status',{cache:'no-store',signal:AbortSignal.timeout(4000)});if(!r.ok)throw Error();const value=await r.json();
  if(value.protocol!=='desk-network-discovery-v1'||value.owner!==owner.id||!value.scans?.arp||!value.scans?.mdns||!value.inventory||!Number.isFinite(value.observed_at)||Math.abs(Date.now()/1000-value.observed_at)>15)throw Error();
  if(['complete','failed'].includes(value.scans.arp.phase)&&networkScanState.notice.startsWith('Scan queued'))networkScanState.notice='';
  networkScanState.value=value;networkScanState.at=Date.now();networkScanState.unavailable=false;
 }catch{networkScanState.unavailable=true;}finally{networkScanState.loading=false;render();}
}
async function requestNetworkScan(){
 if(networkScanState.sending)return;networkScanState.sending=true;networkScanState.notice='';render();
 try{
  const r=await fetch('/network/desk/scan',{method:'POST',headers:{'X-Desk-Action':'scan'},signal:AbortSignal.timeout(8000)});if(!r.ok)throw Error();
  networkScanState.notice='Scan queued · tracking worker and native import';
 }catch{networkScanState.notice='Scan request was not confirmed. Check status before retrying.';}
 finally{networkScanState.sending=false;await pollNetworkScan();render();}
}


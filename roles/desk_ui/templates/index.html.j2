function topologyModel(nodes){
 const findOwner=key=>{const owners=nodes.filter(n=>fresh(n)&&n.vip[key]===true);return {node:owners.length===1?owners[0]:null,label:owners.length>1?'Conflicting owners':owners.length===1?`Owner · ${owners[0].id}`:'Owner unconfirmed'};};
 const xiaozhi=findOwner('xiaozhi'),dns=findOwner('dns'),vpn=findOwner('vpn');
 const health=dns.node&&dnsCurrent(dns.node)?dns.node.dns_health:null;
 const eligible=new Set(health?.mode==='adguard'?(health.eligible_backends||[]).filter(id=>nodes.some(n=>n.id===id&&fresh(n))):[]);
 const vpnStandby=new Set(vpn.node?nodes.filter(n=>fresh(n)&&n.vip.vpn===false&&n.vpn_ready===true).map(n=>n.id):[]);

function drawTopology(){
 if(!currentTopology)return;
 const {nodes,model}=currentTopology,board=document.getElementById('topology'),svg=document.getElementById('topology-links');
 const rect=board.getBoundingClientRect();if(!rect.width||!rect.height)return;
 const cards=[...document.getElementById('nodes').children];
 const endpoint=key=>document.getElementById(`topology-${key}`).getBoundingClientRect();
 const stacked=cards.length>1&&Math.abs(cards[0].getBoundingClientRect().left-cards[1].getBoundingClientRect().left)<1;
 const paths=[],descriptions=[];
 function connect(key,id,kind){
  const index=nodes.findIndex(n=>n.id===id);if(index<0||!cards[index])return;
  const from=endpoint(key),to=cards[index].getBoundingClientRect();
  const offset={xiaozhi:-24,dns:0,vpn:24}[key];
  const x=from.left-rect.left+from.width/2+offset,y=from.bottom-rect.top;

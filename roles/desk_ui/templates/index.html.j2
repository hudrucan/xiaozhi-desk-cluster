async function prepareReboot(node,action='reboot'){const maintained=action==='reboot'&&operationState.latest?.node===node&&operationState.latest?.state==='maintenance';if(!canReboot()&&!maintained)return;const dialog=document.getElementById('reboot-dialog');const description=document.getElementById('reboot-description');const confirm=document.getElementById('reboot-confirm');operationState.prompt=null;confirm.disabled=true;description.textContent='Checking fresh readiness of all three nodes…';dialog.showModal();try{const value=await nodeAction('/prepare',{node,action});if(!dialog.open)return;const member=membership.find(m=>m.id===node);if(value.node!==node||value.ip!==member.management||typeof value.token!=='string'||value.token.length>2048||!finite(value.expires))throw Error('Invalid confirmation response');operationState.prompt=value;document.getElementById('reboot-title').textContent=action==='maintenance'?'Enter maintenance':'Maintenance and reboot';confirm.textContent=action==='maintenance'?'Enter maintenance':'Drain and reboot';const meta=value.metadata||{};const owners=[meta.vip?.xiaozhi?'Xiaozhi VIP':null,meta.vip?.dns?'DNS VIP':null,meta.vip?.vpn?'VPN VIP':null].filter(Boolean).join(' · ')||'No VIP assigned';const jobs=['asr','llm','tts'].map(k=>`${workerName(k)}: ${finite(meta.activity?.[k])?meta.activity[k]:'unknown'}`).join(' · ');description.innerHTML=`<p><strong>${esc(node)}</strong> · ${esc(member.management)}</p><p>${esc(owners)}</p><p>${esc(jobs)}</p><p>${finite(meta.core)?meta.core:'Unknown'} active core conversation(s).</p>`;confirm.disabled=false;clearTimeout(operationState.expiry);operationState.expiry=setTimeout(()=>{confirm.disabled=true;description.textContent='Confirmation expired. Close and prepare again.';operationState.prompt=null;},Math.max(0,value.expires*1000-Date.now()));}catch(error){description.textContent=error.message||'Could not verify node readiness.';}}
document.getElementById('reboot-cancel').addEventListener('click',()=>document.getElementById('reboot-dialog').close());
document.getElementById('reboot-dialog').addEventListener('close',()=>{operationState.prompt=null;clearTimeout(operationState.expiry);});
document.getElementById('reboot-confirm').addEventListener('click',async()=>{const prompt=operationState.prompt;if(!prompt)return;const confirm=document.getElementById('reboot-confirm');confirm.disabled=true;operationState.busy=true;render();try{const value=await nodeAction('/reboot',{token:prompt.token});if(value.accepted!==true||value.node!==prompt.node)throw Error('Reboot acknowledgement unavailable');document.getElementById('reboot-dialog').close();operationState.latest={node:value.node,id:value.id,state:'accepted'};showOperation(`${value.node} — Reboot requested · tracking recovery`);pollOperation();}catch(error){if(error.status)operationState.busy=false;document.getElementById('reboot-description').textContent=error.message||'Reboot acknowledgement unavailable. No automatic retry.';showOperation('Checking whether the reboot was accepted. No automatic retry.');pollOperation();}});
root.addEventListener('click',event=>{const button=event.target.closest('[data-reboot]');if(button&&!button.disabled)prepareReboot(button.dataset.reboot);const maintained=event.target.closest('[data-maintained-reboot]');if(maintained)prepareReboot(maintained.dataset.maintainedReboot);const maintenance=event.target.closest('[data-maintenance]');if(maintenance&&!maintenance.disabled)prepareReboot(maintenance.dataset.maintenance,'maintenance');const resume=event.target.closest('[data-resume]');if(resume)resumeMaintenance(resume.dataset.resume);});
document.addEventListener('visibilitychange',()=>{clearTimeout(operationState.timer);if(!document.hidden)pollOperation();});
if(nodeControlEnabled)pollOperation();

new ResizeObserver(drawTopology).observe(document.getElementById('topology'));
render();poll();

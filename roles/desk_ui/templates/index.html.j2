 if(checkpoint&&snapshots.length){const h=snapshots[0],age=Math.max(0,Math.floor((Date.now()-Date.parse(h.checkpoint_at))/60000));checkpoint.textContent=`Checkpoint r${h.checkpoint_revision} · ${age<1?'just now':`${age}m ago`}`;}

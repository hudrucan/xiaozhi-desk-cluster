[Unit]
Description=Stable authenticated camera signaling ingress
After=network-online.target desk-camera.service
Wants=network-online.target

[Service]
ExecStart=/usr/sbin/haproxy -db -f /etc/desk-camera/proxy.cfg
Restart=on-failure
RestartSec=3
UMask=0077
CPUQuota=10%
MemoryMax=64M
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

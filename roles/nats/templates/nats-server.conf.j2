# Managed by Ansible. Core NATS only; no persistence or JetStream configuration.
server_name: {{ inventory_hostname | to_json }}
listen: {{ (cluster_ip ~ ':' ~ nats_client_port) | to_json }}
http: {{ (cluster_ip ~ ':' ~ nats_monitor_port) | to_json }}
max_payload: {{ nats_max_payload }}
debug: false
trace: false

lame_duck_duration: "30s"
lame_duck_grace_period: "5s"

authorization {
  users: [
{% if desk_homeassistant_enabled | default(false) %}
{% set ha = lookup('file',playbook_dir+'/secret/homeassistant/nats.json') | from_json %}
    # BEGIN DESK HOME ASSISTANT USERS
{% for node, credential in ha.items() %}
    {{ dict(credential, permissions={'publish':{'allow':['desk.homeassistant.control.*','desk.homeassistant.reply.'+node+'.>']},'subscribe':{'allow':['desk.homeassistant.control.'+node,'desk.homeassistant.reply.'+node+'.>']},'allow_responses':{'max':1,'expires':'3s'}}) | to_json }}
{% endfor %}
    # END DESK HOME ASSISTANT USERS
{% endif %}
{% if desk_network_scan_enabled | default(false) %}
{% set scan = lookup('file',playbook_dir+'/secret/network/scan-nats.json') | from_json %}
    # BEGIN DESK NETWORK SCAN USERS
{% for node, credential in scan.coordinators.items() %}
    {{ dict(credential, permissions={'publish':{'allow':['desk.network.scan.*','desk.network.status.*']},'subscribe':{'allow':['desk.network.reply.'+node+'.>']}}) | to_json }}
{% endfor %}
{% for node, credential in scan.workers.items() %}
    {{ dict(credential, permissions={'subscribe':{'allow':['desk.network.scan.'+node,'desk.network.status.'+node]},'allow_responses':{'max':1,'expires':'20s'}}) | to_json }}
{% endfor %}
    # END DESK NETWORK SCAN USERS
{% endif %}
    { user: {{ nats_client_user | to_json }}, password: {{ nats_client_password | to_json }} }
  ]
}

cluster {
  name: {{ nats_cluster_name | to_json }}
  listen: {{ (cluster_ip ~ ':' ~ nats_cluster_port) | to_json }}
  advertise: {{ (cluster_ip ~ ':' ~ nats_cluster_port) | to_json }}
  authorization {
    user: {{ nats_route_user | to_json }}
    password: {{ nats_route_password | to_json }}
  }
  routes: [
{% for peer in groups['deskboxes'] | sort if peer != inventory_hostname %}
    {{ ('nats://' ~ nats_route_user ~ ':' ~ nats_route_password ~ '@' ~ hostvars[peer].cluster_ip ~ ':' ~ nats_cluster_port) | to_json }}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}

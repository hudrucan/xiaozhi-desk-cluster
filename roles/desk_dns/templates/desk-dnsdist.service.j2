[Unit]
Description=Desk symmetric DNS UDP/TCP frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=desk-dnsdist
Group=desk-dnsdist
Slice=desk-dnsfront.slice
ExecStartPre=/usr/bin/dnsdist --check-config -C /etc/desk-dns/dnsdist.conf
ExecStart=/usr/bin/dnsdist --supervised --disable-syslog -C /etc/desk-dns/dnsdist.conf
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
CPUWeight=10
MemoryHigh=64M
MemoryMax=80M
TasksMax=32
LimitNOFILE=4096
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

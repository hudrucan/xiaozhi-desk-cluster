# Managed base policy. UI edits are local; see docs/DESK_DNS.md.
http:
  address: "127.0.0.1:{{ desk_dns_web_port }}"
  session_ttl: 720h
  pprof: {enabled: false, port: 6060}
  doh: {insecure_enabled: {{ 'true' if desk_dns_client_identity_enabled | default(false) else 'false' }}}
{% if desk_dns_ui_auth_enabled %}
users:
  - name: {{ desk_dns_admin_user | to_json }}
    password: {{ desk_dns_admin_password_hash | to_json }}
{% else %}
users: []
{% endif %}
dns:
  bind_hosts: [{{ cluster_ip | to_json }}]
  port: {{ desk_dns_backend_port }}
  upstream_dns: {{ desk_dns_upstreams | to_json }}
  upstream_mode: load_balance
  fallback_dns: []
  bootstrap_dns: []
  allowed_clients: {{ (desk_dns_nodes.values() | map(attribute='private') | list + ['127.0.0.1'] + (['192.168.1.0/24', 'fe80::/10'] if desk_dns_client_identity_enabled | default(false) else [])) | to_json }}
{% if desk_dns_client_identity_enabled | default(false) %}
  trusted_proxies: [127.0.0.1/32]
{% endif %}
  disallowed_clients: []
  ratelimit: 0
  refuse_any: true
  cache_enabled: true
  cache_size: 4194304
  cache_optimistic: false
  max_goroutines: 64
  upstream_timeout: 3s
  serve_plain_dns: true
  use_private_ptr_resolvers: false
  hostsfile_enabled: false
  edns_client_subnet: {enabled: false}
tls:
  enabled: false
filtering:
  protection_enabled: true
  filtering_enabled: true
  filters_update_interval: {{ 0 if desk_dns_serialized_updates else 24 }}
  blocking_mode: null_ip
  rewrites_enabled: true
  rewrites:
    - {domain: health.desk-dns.test, answer: 127.0.0.1, enabled: true}
    - {domain: who.desk-dns.test, answer: {{ cluster_ip | to_json }}, enabled: true}
filters:
  - enabled: true
    url: {{ desk_dns_filter_url | to_json }}
    name: AdGuard DNS filter
    id: 1
user_rules: {{ (['||blocked.desk-dns.test^'] + desk_dns_user_rules) | to_json }}
dhcp:
  enabled: false
querylog:
{% if desk_dns_client_identity_enabled | default(false) %}
  ignored: [health.desk-dns.test, who.desk-dns.test, blocked.desk-dns.test]
  ignored_enabled: true
{% endif %}
  enabled: true
  file_enabled: false
  interval: 24h
  size_memory: 1000
statistics:
{% if desk_dns_client_identity_enabled | default(false) %}
  ignored: [health.desk-dns.test, who.desk-dns.test, blocked.desk-dns.test]
  ignored_enabled: true
{% endif %}
  enabled: true
  interval: 24h
schema_version: 34

global
    maxconn 256
    lua-load /usr/local/libexec/desk-dns/maintenance-health.lua
    stats socket /run/desk-dns-backend/admin.sock mode 660 level user

defaults
    mode http
    timeout connect 2s
    timeout client 960s
    timeout server 10s

frontend private_dns_backend
    bind {{ cluster_ip }}:5443 ssl crt /etc/desk-dns/backend/peer.pem alpn h2,http/1.1
    http-request deny unless { src 10.10.10.11 10.10.10.12 10.10.10.13 }
    option http-buffer-request
    acl dns_query path /dns-query
    # Only the reserved health question withdraws; real DNS stays available.
    acl dns_health_question req.body,hex,lower -m sub 066865616c7468086465736b2d646e73047465737400
    http-request deny deny_status 503 if dns_query dns_health_question { lua.desk_node_draining -m bool }
    acl peer_api path_beg /desk-observe/control/ /desk-observe/policy/ /desk-observe/ui/
    http-request deny unless dns_query or peer_api
    http-request del-header CF-Connecting-IP
    http-request del-header True-Client-IP
    http-request del-header X-Real-IP
    acl real_client req.hdr_ip(X-Forwarded-For) -m ip 192.168.1.0/24 fe80::/10
    acl real_client req.hdr(X-Forwarded-For),lower -m sub fe80:
    acl node_probe req.hdr_ip(X-Forwarded-For) -m ip 192.168.1.101 192.168.1.102 192.168.1.103
    use_backend adguard_clients if dns_query real_client !node_probe
    use_backend observe_api if peer_api
    default_backend adguard_doh

backend adguard_doh
    server local 127.0.0.1:3001

backend observe_api
    timeout server 960s
    server local 127.0.0.1:3003

# Separate read-only native statistics; same local AdGuard destination.
backend adguard_clients
    server local 127.0.0.1:3001

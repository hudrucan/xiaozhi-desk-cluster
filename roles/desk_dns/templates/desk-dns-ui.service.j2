[Unit]
Description=Desk DNS VIP authenticated AdGuard UI proxy
Wants=network-online.target desk-adguard.service
After=network-online.target desk-adguard.service

[Service]
Type=simple
User=desk-dnsdist
Group=desk-dnsdist
Slice=desk-dns.slice
ExecStartPre=/usr/sbin/haproxy -c -f /etc/desk-dns/ui-haproxy.cfg
ExecStart=/usr/sbin/haproxy -db -f /etc/desk-dns/ui-haproxy.cfg
Restart=on-failure
RestartSec=3
CPUWeight=5
MemoryMax=32M
TasksMax=16
LimitNOFILE=512
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

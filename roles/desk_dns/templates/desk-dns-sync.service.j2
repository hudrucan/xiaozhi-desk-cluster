[Unit]
Description=Pull shared DNS VIP policy with pinned adguardhome-sync
Wants=desk-dns-sync-agent.service
After=desk-dns-sync-agent.service

[Service]
Type=oneshot
User=desk-dns-sync
Group=desk-dns-sync
Slice=desk-dnssync.slice
ExecStart=/usr/bin/python3 /usr/local/libexec/desk-dns/desk-dns-sync.py pull
StateDirectory=desk-dns-sync
StateDirectoryMode=0700
CPUWeight=5
IOWeight=5
MemoryMax=96M
TasksMax=24
LimitNOFILE=128
TimeoutStartSec=120
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK

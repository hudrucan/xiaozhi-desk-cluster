# Separate from the Xiaozhi HAProxy process and configuration.
global
    maxconn 64

defaults
    mode http
    timeout connect 2s
    timeout client 180s
    timeout server 60s

frontend dns_admin
    bind {{ desk_dns_vip }}:{{ desk_dns_web_port }}
{% if desk_dns_ui_vip_proxy_only | default(false) %}
    http-request deny unless { src {% for node, addresses in desk_dns_nodes | dictsort %}{{ addresses.management }} {% endfor %}127.0.0.1 }
{% else %}
    http-request deny unless { src 192.168.1.0/24 127.0.0.1 }
{% endif %}
    http-response set-header X-Desk-DNS-Node {{ inventory_hostname }}
    # Probe the serving frontend, independently of a compiling AdGuard backend.
    http-request return status 200 content-type application/json string '{"frontend":"ready"}' if { path /control/desk_health }
{% if desk_dns_client_identity_enabled | default(false) %}
    http-request deny if { path_beg /dns-query /desk-observe/ }
    acl cluster_view path / /control/stats /control/querylog /control/clients /control/clients/find /control/clients/search /control/stats_reset /control/querylog_clear /control/querylog/config/update /control/stats/config/update /control/querylog_config /control/stats_config /control/desk_cluster /control/cluster.js /control/filtering/config /control/filtering/add_url /control/filtering/remove_url /control/filtering/set_url /control/filtering/set_rules /control/filtering/refresh
    use_backend cluster_ui if cluster_view
{% endif %}
    default_backend local_adguard

backend local_adguard
    server local 127.0.0.1:{{ desk_dns_web_port }}

{% if desk_dns_client_identity_enabled | default(false) %}
backend cluster_ui
    timeout server 180s
    server local 127.0.0.1:3003
{% endif %}
